# ============================================================
# Docker Compose 环境变量
# 复制此文件为 .env 填入真实值
# cp .env.example .env
# ============================================================

# 数据库密码（MySQL root 密码）
DB_PASSWORD=***

# 高德 Web服务 API Key（用于后端逆地理编码/POI搜索）
# 申请地址：https://lbs.amap.com/
AMAP_WEB_KEY=***

# DeepSeek AI API Key
DEEPSEEK_KEY=***

# 第三方服务 AppCode（实名认证/短信/滑块验证码）
APPCODE=***
