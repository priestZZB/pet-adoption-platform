<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pet.module.pet.mapper.PetFavoriteFolderMapper">

    <resultMap id="BaseResultMap" type="com.pet.module.pet.model.entity.PetFavoriteFolder">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="BaseColumns">
        id, user_id, name, sort_order, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pet_favorite_folder (user_id, name, sort_order)
        VALUES (#{userId}, #{name}, #{sortOrder})
    </insert>

    <update id="updateById">
        UPDATE pet_favorite_folder
        SET name = #{name}, sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM pet_favorite_folder WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM pet_favorite_folder WHERE user_id = #{userId}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM pet_favorite_folder WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM pet_favorite_folder WHERE user_id = #{userId} ORDER BY sort_order ASC, created_at ASC
    </select>

    <select id="countByNameAndUser" resultType="int">
        SELECT COUNT(*) FROM pet_favorite_folder WHERE user_id = #{userId} AND name = #{name}
    </select>
</mapper>
