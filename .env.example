# ==========================================
# 宠物领养救助管理平台 — 环境变量参考
# 复制此文件为 .env 并填入真实值
# ==========================================

# ---- Docker Compose 基础设施 ----
MYSQL_ROOT_PASSWORD=ZZb070104
REDIS_PASSWORD=ZZb070104

# ---- 第三方 API Key（对应 application-secret.yml）----

# DeepSeek AI
DEEPSEEK_API_KEY=sk-***

# JWT 密钥
JWT_SECRET=your-jwt-secret

# 第三方服务 AppCode
APPCODE=your-appcode

# 滑块验证码
CAPTCHA_APP_ID=your-app-id
CAPTCHA_APP_SECRET=***

# 短信服务
SMS_TEMPLATE_ID=your-template-id
SMS_SIGN_ID=your-sign-id

# 高德地图 Web服务 API Key（申请地址：https://lbs.amap.com/）
MAP_API_KEY=your-amap-key
